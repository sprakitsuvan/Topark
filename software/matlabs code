
%% BALL AND BEAM BALANCE SYSTEM
clc;
clear;
close all;

%% 1) PARAMETERS

g = 9.81;

% Beam and ball dimensions (meters)
L = 0.150;                 % Beam length = 150 mm
beamWidth = 0.01625;       % 16.25 mm
beamThickness = 0.00625;   % 6.25 mm
R = 0.005;                 % Ball radius = 5 mm

% Initial conditions
xTarget = 0.0;
xInitial = 0.050;          % 50 mm
vInitial = 0.0;
thetaInitial = 0.0;

% PD controller
Kp = 7.2;
Kd = 4.6;
thetaMax = deg2rad(12);

% Beam actuator
actuatorTimeConstant = 0.08;

% Rolling resistance / damping
velocityDamping = 0.12;

% Simulation and animation
tEnd = 8;
animationFrames = 260;

%% 2) STAND DIMENSIONS

baseLength = 0.130;
baseWidth = 0.055;
baseThickness = 0.010;

pivotHeight = 0.095;
bearingHeight = 0.00875;

columnLength = pivotHeight ...
    - beamThickness/2 ...
    - bearingHeight ...
    - baseThickness;

columnWidth = 0.01625;
columnDepth = 0.01875;

bearingLength = 0.02625;
bearingWidth = 0.02875;

shaftRadius = 0.003;

%% 3) RUN BALL AND BEAM DYNAMICS

y0 = [xInitial; vInitial; thetaInitial];

params.g = g;
params.Kp = Kp;
params.Kd = Kd;
params.thetaMax = thetaMax;
params.tau = actuatorTimeConstant;
params.damping = velocityDamping;
params.xTarget = xTarget;
params.xLimit = L/2 - R;

opts = odeset('RelTol',1e-7,'AbsTol',1e-9);

[t,y] = ode45(@(t,y) ballBeamODE(t,y,params), ...
              [0 tEnd],y0,opts);

x = y(:,1);
v = y(:,2);
theta = y(:,3);

thetaCommand = zeros(size(t));

for k = 1:numel(t)
    thetaCommand(k) = controllerAngle(x(k),v(k),params);
end

%% 4) PLOT RESPONSE GRAPHS

figure('Name','Ball and Beam Response','Color','w');

subplot(3,1,1);

plot(t,x*1000,'LineWidth',1.8);
hold on;
yline(xTarget*1000,'--','Target');

grid on;
ylabel('Ball Position (mm)');
title('Ball and Beam Closed-Loop Response');

subplot(3,1,2);

plot(t,rad2deg(theta),'LineWidth',1.8);
hold on;

plot(t,rad2deg(thetaCommand),'--','LineWidth',1.2);

grid on;
ylabel('Beam Angle (deg)');

legend('Actual Angle','Command Angle', ...
       'Location','best');

subplot(3,1,3);

plot(t,v*1000,'LineWidth',1.8);

grid on;
ylabel('Ball Velocity (mm/s)');
xlabel('Time (s)');

%% 5) BUILD 3D MODEL
%% GROUND + BASE + SUPPORT + BEAM + BALL

fig = figure('Name','3D Ball and Beam - 150 mm', ...
             'Color',[0.96 0.96 0.96]);

ax = axes('Parent',fig);

hold(ax,'on');
grid(ax,'on');
axis(ax,'equal');

view(ax,[-34 22]);

xlabel(ax,'X (beam direction) [m]');
ylabel(ax,'Y (width) [m]');
zlabel(ax,'Z (height) [m]');

title(ax,'Ball and Beam Balance System - 150 mm');

xlim(ax,[-0.120 0.120]);
ylim(ax,[-0.075 0.075]);
zlim(ax,[-0.010 0.140]);

%% 5.1 Ground plane

[gX,gY] = meshgrid(linspace(-0.120,0.120,2), ...
                   linspace(-0.070,0.070,2));

gZ = zeros(size(gX));

surf(ax,gX,gY,gZ, ...
    'FaceColor',[0.82 0.84 0.86], ...
    'FaceAlpha',0.35, ...
    'EdgeColor',[0.68 0.70 0.72], ...
    'LineStyle','-');

%% 5.2 Fixed base

makeBox(ax,[baseLength baseWidth baseThickness], ...
    [0 0 baseThickness/2],[1 0 0]);

%% 5.3 Vertical support column

columnCenterZ = baseThickness + columnLength/2;

makeBox(ax,[columnWidth columnDepth columnLength], ...
    [0 0 columnCenterZ],[1 0 0]);

%% 5.4 Bearing block

bearingCenterZ = pivotHeight ...
    - beamThickness/2 ...
    - bearingHeight/2;

makeBox(ax,[bearingLength bearingWidth bearingHeight], ...
    [0 0 bearingCenterZ],[1 0 0]);

%% 5.5 Pivot shaft (RED)

a = linspace(0,2*pi,36);

yy = linspace(-beamWidth*0.72, ...
               beamWidth*0.72,3);

[A,Ycyl] = meshgrid(a,yy);

Xcyl = shaftRadius*cos(A);

Zcyl = pivotHeight + shaftRadius*sin(A);

surf(ax,Xcyl,Ycyl,Zcyl, ...
    'FaceColor',[1 0 0], ...
    'EdgeColor','none');

%% 5.6 Center marker

centerMarker = plot3(ax,0,0, ...
    pivotHeight+beamThickness/2+0.001, ...
    'k+','MarkerSize',11,'LineWidth',1.6);

%% 5.7 Beam (GREEN)

[beamVertices,beamFaces] = boxMesh( ...
    [L beamWidth beamThickness]);

beamWorldVertices = transformBeam( ...
    beamVertices,0,pivotHeight);

beamPatch = patch(ax, ...
    'Vertices',beamWorldVertices, ...
    'Faces',beamFaces, ...
    'FaceColor',[0 1 0], ...
    'EdgeColor',[0.04 0.05 0.07], ...
    'LineWidth',0.8);

%% 5.8 Ball (BLUE)

[sx,sy,sz] = sphere(24);

ballSurf = surf(ax,R*sx,R*sy,R*sz, ...
    'FaceColor',[0 0 1], ...
    'EdgeColor',[0.25 0.27 0.30], ...
    'LineWidth',0.35);

%% 5.9 Labels

text(ax,-baseLength/2+0.004, ...
    -baseWidth/2-0.006, ...
    baseThickness+0.002, ...
    'GROUND / FIXED BASE', ...
    'FontSize',8,'FontWeight','bold');

statusText = text(ax,-0.105,-0.065,0.130,'', ...
    'FontSize',9,'FontWeight','bold', ...
    'Color',[0.12 0.15 0.19]);

%% 5.10 Lighting and camera

camlight(ax,'headlight');
lighting(ax,'gouraud');
material(ax,'dull');

set(ax,'FontSize',9,'LineWidth',0.8);

rotate3d(fig,'on');

%% 6) ANIMATE BEAM AND BALL

frameIndices = unique(round( ...
    linspace(1,numel(t),animationFrames)));

for q = 1:numel(frameIndices)

    k = frameIndices(q);

    th = theta(k);

    % Rotate beam about fixed pivot axis (Y axis)

    Vworld = transformBeam( ...
        beamVertices,th,pivotHeight);

    set(beamPatch,'Vertices',Vworld);

    % Center marker

    markerX = -beamThickness/2*sin(th);

    markerZ = pivotHeight ...
        + beamThickness/2*cos(th) ...
        + 0.001;

    set(centerMarker, ...
        'XData',markerX, ...
        'YData',0, ...
        'ZData',markerZ);

    % Ball position

    ballLocalX = x(k);

    ballLocalZ = beamThickness/2 + R;

    ballCenterX = ballLocalX*cos(th) ...
        - ballLocalZ*sin(th);

    ballCenterZ = pivotHeight ...
        + ballLocalX*sin(th) ...
        + ballLocalZ*cos(th);

    set(ballSurf, ...
        'XData',R*sx+ballCenterX, ...
        'YData',R*sy, ...
        'ZData',R*sz+ballCenterZ);

    % Status display

    set(statusText,'String',sprintf( ...
        'Time: %.2f s | Ball: %.2f mm | Beam: %.2f deg', ...
        t(k),x(k)*1000,rad2deg(th)));

    drawnow;

    pause(0.008);

end

%% 7) PRINT FINAL RESULT

fprintf('\n===== BALL AND BEAM RESULT =====\n');

fprintf('Beam length           : %.2f mm\n',L*1000);
fprintf('Beam width            : %.2f mm\n',beamWidth*1000);
fprintf('Beam thickness        : %.2f mm\n',beamThickness*1000);
fprintf('Ball radius           : %.2f mm\n',R*1000);

fprintf('Initial ball position : %.2f mm\n',xInitial*1000);
fprintf('Target ball position  : %.2f mm\n',xTarget*1000);

fprintf('Final ball position   : %.4f mm\n',x(end)*1000);
fprintf('Final ball velocity   : %.4f mm/s\n',v(end)*1000);
fprintf('Final beam angle      : %.3f deg\n',rad2deg(theta(end)));

fprintf('Moving DOF            : 2\n');
fprintf('Ground / stand DOF    : 0\n');

fprintf('================================\n');

if abs(x(end)-xTarget)<0.01 && abs(v(end))<0.02

    disp('Result: ball is close to the center and nearly stopped.');

else

    disp('Result: try tuning Kp, Kd, or actuator time constant.');

end

%% 8) LOCAL FUNCTIONS

function dydt = ballBeamODE(~,y,p)

    x = y(1);
    ballVelocity = y(2);
    beamAngle = y(3);

    thetaCmd = controllerAngle(x,ballVelocity,p);

    beamAngleRate = (thetaCmd-beamAngle)/p.tau;

    % Solid sphere rolling without slipping

    ballAcceleration = -(5/7)*p.g*sin(beamAngle) ...
                       - p.damping*ballVelocity;

    % Ball travel limit

    if x >= p.xLimit && ballVelocity > 0

        ballAcceleration = min(ballAcceleration,0);

    elseif x <= -p.xLimit && ballVelocity < 0

        ballAcceleration = max(ballAcceleration,0);

    end

    dydt = [ballVelocity;
            ballAcceleration;
            beamAngleRate];

end

function thetaCmd = controllerAngle(x,ballVelocity,p)

    positionError = x-p.xTarget;

    thetaCmd = p.Kp*positionError ...
               + p.Kd*ballVelocity;

    thetaCmd = min(max(thetaCmd, ...
        -p.thetaMax),p.thetaMax);

end

function [V,F] = boxMesh(dimensions)

    hx = dimensions(1)/2;
    hy = dimensions(2)/2;
    hz = dimensions(3)/2;

    V = [-hx -hy -hz;
          hx -hy -hz;
          hx  hy -hz;
         -hx  hy -hz;
         -hx -hy  hz;
          hx -hy  hz;
          hx  hy  hz;
         -hx  hy  hz];

    F = [1 2 3 4;
         5 8 7 6;
         1 5 6 2;
         2 6 7 3;
         3 7 8 4;
         4 8 5 1];

end

function Vworld = transformBeam(Vlocal,theta,pivotZ)

    c = cos(theta);
    s = sin(theta);

    xw = Vlocal(:,1)*c - Vlocal(:,3)*s;

    yw = Vlocal(:,2);

    zw = Vlocal(:,1)*s + Vlocal(:,3)*c + pivotZ;

    Vworld = [xw yw zw];

end

function h = makeBox(ax,dimensions,center,faceColor)

    [V,F] = boxMesh(dimensions);

    V(:,1) = V(:,1)+center(1);
    V(:,2) = V(:,2)+center(2);
    V(:,3) = V(:,3)+center(3);

    h = patch(ax, ...
        'Vertices',V, ...
        'Faces',F, ...
        'FaceColor',faceColor, ...
        'EdgeColor',[0.08 0.09 0.11], ...
        'LineWidth',0.8);

end
